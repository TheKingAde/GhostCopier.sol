# Copy this file to .env and fill in your own values.

# Solana RPC endpoint. The public mainnet-beta endpoint is heavily rate
# limited and WILL cause missed/delayed trade detection under real use.
# Get a free key from Helius (helius.dev), QuickNode, or Triton and put
# the full RPC URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How often (seconds) each watched wallet is polled for new transactions.
POLL_INTERVAL_SECONDS=20

# How many signatures to pull per poll when catching up.
SIGNATURE_FETCH_LIMIT=15

# Default simulated trading friction (percent, e.g. 0.5 = 0.5%)
DEFAULT_SLIPPAGE_PCT=0.5
DEFAULT_FEE_PCT=0.3

# Default position sizing strategy for new sessions:
# "proportional" (mirror the % of the source wallet's own balance used)
# or "fixed_pct" (always risk a fixed % of the session balance per trade)
DEFAULT_SIZING_MODE=proportional
DEFAULT_SIZING_PCT=10

# SOL/USD price cache lifetime, seconds
PRICE_CACHE_TTL=30

# SQLite file
DB_PATH=ghostcopier.db

HOST=0.0.0.0
PORT=5000
